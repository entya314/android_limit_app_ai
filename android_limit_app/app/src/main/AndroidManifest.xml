<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 10のPrivate DNS設定APIはアプリ側でTLS接続を確認するため、通信権限が必要です。
        INTERNETは通常権限なので、利用者への実行時の許可ダイアログは表示されません。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 30分後の再制限と、再起動・画面ロック中の復帰に使用します。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.device_admin" android:required="true" />

    <!--
        β版の重要な設定です。
        testOnly=trueにすることで、ADBのremove-active-adminでDevice Ownerを解除できます。
        releaseビルドでも維持します。インストール時はadb install -tを使用してください。
    -->
    <application
        android:name=".FocusDpcApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_focus"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.FocusDPC">

        <!-- 解除の入口はPCのADB shellだけ。通常アプリはDUMP権限とUID検査で拒否します。 -->
        <provider
            android:name=".InstallMaintenanceProvider"
            android:authorities="io.github.focusdpc.maintenance"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".InstallMaintenanceReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exportedでもBIND_DEVICE_ADMINにより、管理用通知を送れるのはシステムだけです。 -->
        <receiver
            android:name=".MyDeviceAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
